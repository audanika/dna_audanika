{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "dna_audanika",

  // 1-2 sentence summary about this repo.
  "summary": "DNA umbrella of the audanika repos: one layer that pulls in every topic layer, the audanika identity variables and the shared LICENSE.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "DNA composition: readme, guides, index, blog, translate, install, vscode, clean code, gg workflow, github",
    "Audanika identity as dna vars: company, copyright holder, GitHub org and URL, ticket prefix",
    "Shared LICENSE placed into every audanika repo"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "dna_readme": "README structure and templates",
      "dna_guides": "developer and AI guides",
      "dna_index": "index.jsonc template and guide",
      "dna_blog": "blog guide, post template, /blog skill",
      "dna_translate": "translate guide, german post template, /translate skill",
      "dna_install": "install guides",
      "dna_vscode": "editor settings and extensions",
      "dna_clean_code": "code and test conventions",
      "dna_gg": "gg workflow skills and scripts",
      "dna_github": "GitHub workflow and repo setup"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "dna_audanika_private": "derives the DNA of the private audanika repos from it"
    }
  }
}
