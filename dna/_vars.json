{
  // The audanika identity. Everything else is inherited from the topic
  // layers, which default to the ggsuite values — without these the
  // instances would carry ggsuite's name into every audanika repo (the
  // psi-header author, the badge URLs of the readme template, the ticket
  // ids of the AI dev guide).
  "dnaCompany": "Audanika",
  "dnaCopyrightHolder": "Audanika. All Rights Reserved.",
  "dnaGitOrg": "audanika-private",
  "dnaJiraPrefix": "AUD",

  // Spelled out instead of inheriting "https://github.com/dnaGitOrg":
  // a reference renders the value in the casing of the reference, so the
  // lowerCamel dnaGitOrg would turn audanika-private into audanikaPrivate
  // and the badge URLs would point nowhere.
  "dnaGitOrgUrl": "https://github.com/audanika-private"
}
